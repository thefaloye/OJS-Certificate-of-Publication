msgstr "Signatory name"

msgid "plugins.generic.bijphgrPublicationCertificate.settings.signatoryTitle"
msgstr "Signatory title"

msgid "plugins.generic.bijphgrPublicationCertificate.settings.signature"
msgstr "Signature image"

msgid "plugins.generic.bijphgrPublicationCertificate.settings.signatureHelp"
msgstr "PNG or JPEG, up to 1 MB. A transparent PNG works best. Stored privately, never publicly accessible."

msgid "plugins.generic.bijphgrPublicationCertificate.settings.removeSignature"
msgstr "Remove the current signature image"

