msgstr "Notification e-mail"

msgid "plugins.generic.bijphgrPublicationCertificate.settings.emailHelp"
msgstr "Available variables: {$authorName}, {$articleTitle}, {$articleId}, {$allAuthors}, {$journalName}, {$journalUrl}, {$volume}, {$issue}, {$publicationDate}, {$doi}, {$articleUrl}, {$certificateNumber}, {$certificateUrl}, plus {$issueLine} and {$doiLine}, which print a whole line only when a value exists."

