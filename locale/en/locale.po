msgid "plugins.generic.bijphgrPublicationCertificate.displayName"
msgstr "BIJPHGR Publication Certificate"

msgid "plugins.generic.bijphgrPublicationCertificate.description"
msgstr "Issues a PDF Certificate of Publication when an article becomes publicly available and e-mails it to the corresponding author."

msgid "plugins.generic.bijphgrPublicationCertificate.settings.incomplete"
msgstr "Setup incomplete."

msgid "plugins.generic.bijphgrPublicationCertificate.settings.incompleteHelp"
msgstr "No certificate will be issued or e-mailed until the signatory name and the publisher name are set. Articles published in the meantime are held and released automatically when you save complete settings."

msgid "plugins.generic.bijphgrPublicationCertificate.settings.issuer"
msgstr "Issuer and signatory"

msgid "plugins.generic.bijphgrPublicationCertificate.settings.publisherName"
msgstr "Publisher name"

msgid "plugins.generic.bijphgrPublicationCertificate.settings.publisherNameHelp"
msgstr "Printed on the certificate. If left empty, the journal's publisher setting is used."

